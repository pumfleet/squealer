          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两者"
          }
        }
      }
    },
    "Broader ads and tracking coverage; occasionally blocks something you use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breitere Abdeckung von Werbung und Tracking; blockiert gelegentlich etwas, das genutzt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayor cobertura de anuncios y rastreo; a veces bloquea algo que usas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couverture plus large des publicités et du suivi ; bloque parfois quelque chose que vous utilisez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告とトラッキングをより広くカバーします。使用中のものがブロックされることもあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更广泛地覆盖广告和跟踪；偶尔会拦截你使用的内容。"
          }
        }
      }
    },
    "Browsers connect to every site you visit, so allowing any server is usually what you want.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser verbinden sich mit jeder besuchten Website, daher ist es meist sinnvoll, jeden Server zu erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los navegadores se conectan a todos los sitios que visitas, así que normalmente lo que quieres es permitir cualquier servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les navigateurs se connectent à chaque site que vous visitez : autoriser tout serveur est donc généralement ce que vous voulez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザはアクセスするすべてのサイトに接続するため、通常は任意のサーバを許可するのが適切です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器会连接你访问的每个网站，因此通常应允许任意服务器。"
          }
        }
      }
    },
