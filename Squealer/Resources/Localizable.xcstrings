    "Connections Squealer allowed without asking wait for you in Review, so you can make rules whenever you like.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungen, die Squealer ohne Nachfrage erlaubt hat, warten unter „Prüfen“, damit jederzeit Regeln dafür erstellt werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conexiones que Squealer permitió sin preguntar te esperan en Revisión para que crees reglas cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions que Squealer a autorisées sans demander vous attendent dans Examen, pour que vous puissiez créer des règles quand vous le souhaitez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealerが確認なしで許可した接続は「レビュー」に保存されるので、いつでもルールを作成できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer 未经询问而允许的连接会在“审查”中等你处理，你可以随时为其创建规则。"
          }
        }
      }
    },
    "Connections allowed or denied without asking you, for example in silent mode, collect here so you can make rules for them later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungen, die ohne Nachfrage erlaubt oder abgelehnt wurden (z. B. im stillen Modus), werden hier gesammelt, damit später Regeln dafür erstellt werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conexiones permitidas o denegadas sin preguntarte, por ejemplo, en modo silencioso, se acumulan aquí para que puedas crear reglas más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions autorisées ou refusées sans vous demander, par exemple en mode silencieux, sont rassemblées ici pour que vous puissiez créer des règles plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイレントモードなど、確認なしで許可または拒否された接続はここに集められ、あとでルールを作成できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经询问而允许或拒绝的连接（例如在静默模式下）会汇集在这里，方便你稍后为其创建规则。"
          }
        }
      }
    },
    "Connections allowed without a rule": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Regel erlaubte Verbindungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiones permitidas sin regla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexions autorisées sans règle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールなしで許可された接続"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无规则时允许的连接"
          }
        }
      }
    },
    "Connections appear here as soon as apps use the network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungen erscheinen hier, sobald Apps das Netzwerk nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conexiones aparecen aquí en cuanto las apps usan la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions s’affichent ici dès que des apps utilisent le réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appがネットワークを使用すると、すぐにここに接続が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 一使用网络，连接就会显示在这里。"
          }
        }
      }
    },
    "Connections decided without you are collected in Review so you can make rules for them later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Nachfrage entschiedene Verbindungen werden unter „Prüfen“ gesammelt, damit später Regeln dafür erstellt werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conexiones decididas sin ti se acumulan en Revisión para que puedas crear reglas más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions décidées sans vous sont rassemblées dans Examen pour que vous puissiez créer des règles plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動で判断された接続は「レビュー」に集められ、あとでルールを作成できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经你决定的连接会汇集在“审查”中，方便你稍后为其创建规则。"
          }
        }
      }
    },
    "Connections denied by your rules or blocklists show up here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Regeln oder Sperrlisten abgelehnte Verbindungen erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen las conexiones denegadas por tus reglas o listas de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions refusées par vos règles ou vos listes de blocage s’affichent ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールまたはブロックリストで拒否された接続がここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被你的规则或拦截列表拒绝的连接会显示在这里。"
          }
        }
      }
    },
