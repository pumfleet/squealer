    "A quiet alert appears when an app reaches a new server. Allow it once, for an hour, or forever.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine App einen neuen Server erreicht, erscheint ein dezenter Hinweis. Die Verbindung lässt sich einmal, für eine Stunde oder dauerhaft erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece un aviso discreto cuando una app contacta con un servidor nuevo. Permítelo una vez, durante una hora o para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alerte discrète s’affiche lorsqu’une app contacte un nouveau serveur. Autorisez-la une fois, pendant une heure ou pour toujours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appが新しいサーバに接続しようとすると、控えめなアラートが表示されます。1回だけ、1時間、または永久に許可できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 连接新服务器时，会显示一个低调的提醒。你可以允许一次、允许一小时或永久允许。"
          }
        }
      }
    },
    "A small, long-maintained list of ad servers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine, seit Langem gepflegte Liste von Werbeservern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lista pequeña de servidores de anuncios, mantenida desde hace años."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite liste de serveurs publicitaires, maintenue de longue date."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長年メンテナンスされている、小規模な広告サーバのリスト。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份小巧且长期维护的广告服务器列表。"
          }
        }
      }
    },
