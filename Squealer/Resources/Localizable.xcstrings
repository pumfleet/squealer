    "Installs `squealer` in /usr/local/bin, for scripting and checking status from Terminal. Changing settings from the command line requires sudo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert `squealer` in /usr/local/bin, zum Skripten und Prüfen des Status im Terminal. Zum Ändern von Einstellungen über die Befehlszeile ist sudo erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala `squealer` en /usr/local/bin para crear scripts y consultar el estado desde Terminal. Cambiar los ajustes desde la línea de comandos requiere sudo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe `squealer` dans /usr/local/bin, pour écrire des scripts et vérifier l’état depuis Terminal. La modification des réglages en ligne de commande nécessite sudo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`squealer`を/usr/local/binにインストールし、ターミナルからスクリプトを実行したり状況を確認したりできるようにします。コマンドラインから設定を変更するにはsudoが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 `squealer` 安装到 /usr/local/bin，用于编写脚本以及在“终端”中检查状态。通过命令行更改设置需要 sudo。"
          }
        }
      }
    },
