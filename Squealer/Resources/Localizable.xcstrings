    "See every app that talks to the internet, and decide which ones may.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede App sehen, die mit dem Internet kommuniziert, und entscheiden, welche das darf."
          }
        },
        "es": {
