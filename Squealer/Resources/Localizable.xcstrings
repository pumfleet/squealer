    "Your current rules and settings are replaced. They're backed up first, so you can undo this.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Regeln und Einstellungen werden ersetzt. Sie werden zuvor gesichert, sodass dies rückgängig gemacht werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sustituirán tus reglas y ajustes actuales. Antes se hará una copia de seguridad, así que podrás deshacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos règles et réglages actuels sont remplacés. Ils sont d’abord sauvegardés : vous pourrez donc annuler cette opération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のルールと設定は置き換えられます。事前にバックアップされるため、元に戻すことができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你当前的规则和设置将被替换。它们会先被备份，因此你可以撤销此操作。"
          }
        }
      }
    },
    "Your rules always take precedence over these defaults.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Regeln haben immer Vorrang vor diesen Standardeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reglas siempre tienen prioridad sobre estos valores por omisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos règles ont toujours la priorité sur ces réglages par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのデフォルトよりも、自分のルールが常に優先されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的规则始终优先于这些默认设置。"
          }
        }
      }
    },
    "Your rules are kept.": {
      "localizations": {
        "de": {
