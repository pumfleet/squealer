    "%lld connections are ready to review. From now on, new connections ask first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Verbindungen können jetzt geprüft werden. Ab sofort wird bei neuen Verbindungen zuerst gefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld conexiones están listas para revisar. A partir de ahora, las conexiones nuevas preguntarán primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld connexions sont prêtes à être examinées. Désormais, les nouvelles connexions demandent d’abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の接続を確認できます。今後、新しい接続は事前に確認されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个连接已可供审查。从现在起，新连接会先询问你。"
          }
        }
      }
    },
