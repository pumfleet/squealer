    "Country and network owner data is built in. City-level data makes the map more precise. IP geolocation by DB-IP.com.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten zu Land und Netzbetreiber sind integriert. Daten auf Stadtebene machen die Karte genauer. IP-Geolokalisierung von DB-IP.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de país y propietario de red están integrados. Los datos por ciudad hacen el mapa más preciso. Geolocalización IP de DB-IP.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de pays et de propriétaire du réseau sont intégrées. Les données par ville rendent la carte plus précise. Géolocalisation IP par DB-IP.com."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国とネットワーク所有者のデータは内蔵されています。都市レベルのデータを使うと、マップがより正確になります。IP位置情報はDB-IP.comによるものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国家/地区和网络所有者数据已内置。城市级数据能让地图更精确。IP 地理定位由 DB-IP.com 提供。"
          }
        }
      }
    },
