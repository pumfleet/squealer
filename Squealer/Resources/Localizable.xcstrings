        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa las respuestas DNS de este Mac para que las conexiones muestren nombres en lugar de simples direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveille les réponses DNS sur ce Mac pour que les connexions affichent des noms plutôt que de simples adresses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのDNS応答を監視し、接続をアドレスではなく名前で表示します。"
