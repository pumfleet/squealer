    "History": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录"
          }
        }
      }
    },
    "History and the connection log never leave this Mac. They record which app connected where and how much data moved, never the content of your traffic.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf und Verbindungsprotokoll verlassen diesen Mac nie. Sie zeichnen auf, welche App sich wohin verbunden hat und wie viele Daten übertragen wurden – niemals den Inhalt des Datenverkehrs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial y el registro de conexiones nunca salen de este Mac. Registran qué app se conectó adónde y cuántos datos se transfirieron, nunca el contenido de tu tráfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique et le journal des connexions ne quittent jamais ce Mac. Ils enregistrent quelle app s’est connectée où et la quantité de données échangée, jamais le contenu de votre trafic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴と接続ログがこのMacの外に送信されることはありません。記録されるのは、どのAppがどこに接続し、どれだけのデータが送受信されたかだけで、トラフィックの内容は記録されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录和连接日志从不会离开这台 Mac。它们记录哪个 App 连接到了哪里以及传输了多少数据，从不记录流量内容。"
          }
        }
      }
    },
