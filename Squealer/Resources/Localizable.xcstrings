    "Blocklists": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrlisten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas de bloqueo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listes de blocage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックリスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拦截列表"
          }
        }
      }
    },
    "Blocklists deny connections to known ad, tracking and malware servers for every app. Your own rules always take precedence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrlisten lehnen Verbindungen zu bekannten Werbe-, Tracking- und Malware-Servern für alle Apps ab. Eigene Regeln haben immer Vorrang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas de bloqueo deniegan a todas las apps las conexiones a servidores conocidos de anuncios, rastreo y malware. Tus propias reglas siempre tienen prioridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes de blocage refusent, pour toutes les apps, les connexions aux serveurs connus de publicité, de suivi et de logiciels malveillants. Vos propres règles ont toujours la priorité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックリストは、すべてのAppについて既知の広告、トラッキング、マルウェアのサーバへの接続を拒否します。自分で作成したルールが常に優先されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拦截列表会为所有 App 拒绝连接到已知的广告、跟踪和恶意软件服务器。你自己的规则始终优先。"
          }
        }
      }
    },
    "Blocks ads and trackers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert Werbung und Tracker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea anuncios y rastreadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque les publicités et les traqueurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告とトラッカーをブロックします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拦截广告和跟踪器。"
          }
        }
      }
    },
    "Bonjour, AirPlay, casting and printer discovery on your local network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour, AirPlay, Casting und Druckererkennung im lokalen Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour, AirPlay, transmisión y descubrimiento de impresoras en tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour, AirPlay, diffusion et découverte des imprimantes sur votre réseau local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワーク上のBonjour、AirPlay、キャスト、プリンタの検出。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网络上的 Bonjour、AirPlay、投屏和打印机发现。"
          }
        }
      }
    },
    "Both": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide"
          }
        },
        "es": {
          "stringUnit": {
