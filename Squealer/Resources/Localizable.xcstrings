            "value": "Jede Verbindung wird beim Schließen protokolliert, zusammen mit der genutzten Datenmenge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada conexión se registra al cerrarse, junto con la cantidad de datos que ha usado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque connexion est consignée à sa fermeture, avec la quantité de données utilisée."
