    "Filtering continues with your rules, but Squealer can't ask about new connections or show live traffic until it reconnects.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Filtern läuft mit den eigenen Regeln weiter, aber Squealer kann bis zur erneuten Verbindung nicht nach neuen Verbindungen fragen oder Live-Datenverkehr anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtrado sigue con tus reglas, pero Squealer no puede preguntar por conexiones nuevas ni mostrar el tráfico en directo hasta que se vuelva a conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtrage continue avec vos règles, mais Squealer ne peut pas demander pour les nouvelles connexions ni afficher le trafic en direct tant que la liaison n’est pas rétablie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールによるフィルタリングは継続されますが、再接続するまでSquealerは新しい接続の確認やリアルタイムのトラフィックの表示ができません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过滤会根据你的规则继续进行，但在重新连接前，Squealer 无法询问新连接或显示实时流量。"
          }
        }
      }
    },
    "Filtering is off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter ist deaktiviert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtrado está desactivado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtrage est désactivé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタリングはオフです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过滤已关闭"
          }
        }
      }
    },
    "Filtering keeps working when Squealer isn't open; you just won't be asked about new connections.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Filtern funktioniert auch, wenn Squealer nicht geöffnet ist – es wird dann nur nicht nach neuen Verbindungen gefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtrado sigue funcionando aunque Squealer no esté abierto; simplemente no se te preguntará por las conexiones nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtrage continue quand Squealer n’est pas ouvert ; on ne vous demandera simplement rien pour les nouvelles connexions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealerを開いていなくてもフィルタリングは機能します。新しい接続について確認されないだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer 未打开时过滤仍会继续，只是不会询问你新连接。"
          }
        }
      }
    },
    "Filtering stops immediately. You can then move Squealer to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Filtern wird sofort beendet. Anschließend kann Squealer in den Papierkorb bewegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtrado se detiene de inmediato. Después puedes trasladar Squealer a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtrage s’arrête immédiatement. Vous pouvez ensuite placer Squealer dans la Corbeille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタリングはすぐに停止します。その後、Squealerをゴミ箱に入れることができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过滤会立即停止。然后你可以将 Squealer 移到废纸篓。"
          }
        }
      }
    },
