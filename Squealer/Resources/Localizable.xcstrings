    "Squealer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer"
          }
        }
      }
    },
    "Squealer backs up your rules, groups, profiles, blocklists and settings once a day and keeps the last two weeks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer sichert Regeln, Gruppen, Profile, Sperrlisten und Einstellungen einmal täglich und behält die Backups der letzten zwei Wochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer hace una copia de seguridad de tus reglas, grupos, perfiles, listas de bloqueo y ajustes una vez al día y conserva las de las dos últimas semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer sauvegarde vos règles, groupes, profils, listes de blocage et réglages une fois par jour et conserve les deux dernières semaines."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealerはルール、グループ、プロファイル、ブロックリスト、設定を1日1回バックアップし、過去2週間分を保持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer 每天备份一次你的规则、组、配置文件、拦截列表和设置，并保留最近两周的备份。"
          }
        }
      }
    },
    "Squealer filters connections with a network extension built into macOS. It never sees the content of your traffic, only which app connects where.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer filtert Verbindungen mit einer in macOS integrierten Netzwerkerweiterung. Squealer sieht nie den Inhalt des Datenverkehrs, nur welche App sich wohin verbindet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer filtra las conexiones con una extensión de red integrada en macOS. Nunca ve el contenido de tu tráfico, solo qué app se conecta adónde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer filtre les connexions grâce à une extension réseau intégrée à macOS. Il ne voit jamais le contenu de votre trafic, seulement quelle app se connecte où."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SquealerはmacOSに組み込まれたネットワーク機能拡張を使って接続をフィルタします。トラフィックの内容を見ることはなく、どのAppがどこに接続するかだけを確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Squealer 通过 macOS 内置的网络扩展过滤连接。它从不查看流量内容，只了解哪个 App 连接到了哪里。"
          }
        }
      }
    },
