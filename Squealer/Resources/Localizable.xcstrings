    "Ask before other devices connect to apps on this Mac, for example file sharing or a development server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen, bevor andere Geräte sich mit Apps auf diesem Mac verbinden, z. B. bei Dateifreigabe oder einem Entwicklungsserver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar antes de que otros dispositivos se conecten a apps de este Mac, por ejemplo, Compartir archivos o un servidor de desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander avant que d’autres appareils se connectent à des apps sur ce Mac, par exemple pour le partage de fichiers ou un serveur de développement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのデバイスがこのMacのAppに接続する前に確認します（ファイル共有や開発サーバなど）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他设备连接到这台 Mac 上的 App 之前询问，例如文件共享或开发服务器。"
          }
        }
      }
