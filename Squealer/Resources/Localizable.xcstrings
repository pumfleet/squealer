    "Switch modes and profiles, and see what's active right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modi und Profile wechseln und sehen, was gerade aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
