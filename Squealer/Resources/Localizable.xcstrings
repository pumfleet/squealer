    "Apps in your Applications folder keep connecting without asking. New apps you install later will ask.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps im Ordner „Programme“ verbinden sich weiterhin ohne Nachfrage. Bei später installierten Apps wird gefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps de tu carpeta Aplicaciones seguirán conectándose sin preguntar. Las apps nuevas que instales después preguntarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps de votre dossier Applications continuent de se connecter sans demander. Les nouvelles apps que vous installerez demanderont."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリケーション」フォルダ内のAppは引き続き確認なしで接続します。今後インストールする新しいAppは確認されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“应用程序”文件夹中的 App 会继续无需询问即可连接。以后安装的新 App 会先询问。"
          }
        }
      }
    },
