    "Protects rules and settings from anyone else using this Mac. Answering alerts never asks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützt Regeln und Einstellungen vor anderen Personen, die diesen Mac verwenden. Zum Beantworten von Hinweisen ist nie eine Bestätigung nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege las reglas y los ajustes frente a otras personas que usen este Mac. Responder a los avisos nunca lo pide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protège les règles et les réglages des autres utilisateurs de ce Mac. Répondre aux alertes ne demande jamais d’authentification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacを使用するほかのユーザからルールと設定を保護します。アラートへの応答時には要求されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止使用这台 Mac 的其他人更改规则和设置。回应提醒时无需验证。"
          }
        }
      }
    },
