    "Ads and trackers, tuned to avoid breaking sites.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung und Tracker – abgestimmt, um keine Websites zu beeinträchtigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
